# Alchemy: dashboard -> your Starknet Mainnet app -> HTTPS URL
RPC_URL=
# Supabase DB URL. Prefer Session pooler (IPv4) — Docker can't reach the
# direct db.*.supabase.co host (IPv6-only). Dashboard → Database → Connection
# string → Session pooler. User looks like postgres.<project_ref>.
DATABASE_URL=

# Same as the site ADMIN_PASSWORD. Lets /etheracts/admin pause and resume.
CONTROL_SECRET=

# Mainnet values, no need to change
CONTRACT_ADDRESS=0x03d7811b831bfb98d3c3ac9d7dcc28b43445c35afc82a931d5c06ebc2804f740
START_BLOCK=14121414
